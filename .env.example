# ── Database ──────────────────────────────────────────────────────────────────
# Overridden by docker-compose environment block when running in Docker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticket_support

# ── Service-to-service authentication ────────────────────────────────────────
# Callers are services (the NestJS backend and its schedulers), never end users.
#
# SERVICE_AUTH_AUDIENCE: this service's own Cloud Run URL — the `aud` a caller's
# Google OIDC ID token must carry. Leave EMPTY for local development: OIDC
# verification is then off and the shared secret below is the only credential,
# so nothing here needs GCP credentials or network access to Google.
# SERVICE_AUTH_ALLOWED_SERVICE_ACCOUNTS: comma-separated caller SA emails.
# Verification fails closed if this is empty while an audience is set.
# ALLOW_SHARED_SECRET_AUTH: keeps the WEBHOOK_API_KEY header path alive.
SERVICE_AUTH_AUDIENCE=
SERVICE_AUTH_ALLOWED_SERVICE_ACCOUNTS=
ALLOW_SHARED_SECRET_AUTH=true

# Shared secret with the NestJS backend. Sent as X-System-Key or x-agent-key on
# inbound calls, and as X-Agent-Key on this service's calls back to /internal/*.
WEBHOOK_API_KEY=dev-webhook-secret
NESTJS_BASE_URL=http://localhost:3000

# ── LangFuse observability (optional) ────────────────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://localhost:3010
LANGSMITH_API_KEY=lsv2_pt_

OPENAI_API_KEY=sk-proj--

# ── Multi-message coalescing ─────────────────────────────────────────────────
# Rapid WhatsApp message bursts are merged into one agent turn. A turn waits
# until no new fragment has arrived for MESSAGE_SETTLE_SECONDS (capped at
# MESSAGE_SETTLE_MAX_SECONDS total) before invoking the graph.
# MESSAGE_SETTLE_SECONDS=0 disables the wait (runs stay serialized per thread).
MESSAGE_SETTLE_SECONDS=2.0
MESSAGE_SETTLE_MAX_SECONDS=10.0

# ── Query normalization ──────────────────────────────────────────────────────
# Fleet-wide kill switch for the typo-correcting query_normalizer node.
# Rollout is per tenant (TenantSettings.queryNormalizationEnabled in the
# backend); set this to false to disable the feature everywhere.
QUERY_NORMALIZATION_ENABLED=true

# ── Prospecting agent (aurora) ────────────────────────────────────────────────
# Autonomous discovery of organizations for a tenant-configured niche/location.
# Serper (Google SERP REST) powers web search (/search + /places); without a key
# the web_search node returns no results and runs complete with 0 found.
SERPER_API_KEY=
PROSPECTING_MAX_SEARCHES=10
PROSPECTING_FETCH_TIMEOUT_SECONDS=8
PROSPECTING_MAX_RESULTS_PER_SEARCH=10
# Self-improvement knobs. The in-run refinement loop retries with refined
# queries when a run yields fewer than MIN_QUALITY_PROSPECTS quality prospects,
# up to MAX_ITERATIONS total search passes (1 = loop disabled). PLACES_ENABLED
# toggles the Serper /places endpoint; FEEDBACK_EXAMPLES caps how many human
# good/bad examples are injected into the extraction prompt per verdict.
PROSPECTING_MAX_ITERATIONS=2
PROSPECTING_MIN_QUALITY_PROSPECTS=5
PROSPECTING_PLACES_ENABLED=true
PROSPECTING_FEEDBACK_EXAMPLES=6

# ── Enrichment agent (sherlock) ───────────────────────────────────────────────
# One-time research of a single claimed contact's website. MAX_PAGES bounds the
# same-site crawl; MAX_BYTES is a WIRE-byte cap per page (compression is off, so
# a gzip bomb cannot expand past it); TOTAL_BUDGET_SECONDS is the wall clock for
# ALL fetching in one run — httpx timeouts are per-operation, so this is what
# actually stops a slow-trickle server. MAX_ITERATIONS bounds the in-run
# refinement loop (1 = disabled).
SHERLOCK_MAX_PAGES=6
SHERLOCK_MAX_BYTES=524288
SHERLOCK_MAX_PAGE_CHARS=6000
SHERLOCK_FETCH_TIMEOUT_SECONDS=8
SHERLOCK_TOTAL_BUDGET_SECONDS=60
SHERLOCK_MAX_ITERATIONS=2
SHERLOCK_FEEDBACK_EXAMPLES=6
# Website discovery: resolves a contact that has NO website on file (an aurora
# prospect whose extractor found no domain) to its official site via Serper,
# before the crawl. Each query hits /search and /places, so MAX_QUERIES=2 costs
# up to 4 billable requests. MIN_CONFIDENCE is the bar the confirming LLM must
# clear and MARGIN is how far ahead of the runner-up domain the winner must
# score — raising either leaves more prospects without a website, which is the
# safe direction: the accepted URL is written onto the contact.
SHERLOCK_DISCOVERY_ENABLED=true
SHERLOCK_DISCOVERY_MAX_QUERIES=2
SHERLOCK_DISCOVERY_MAX_RESULTS=10
SHERLOCK_DISCOVERY_MIN_CONFIDENCE=0.7
SHERLOCK_DISCOVERY_MARGIN=0.15
