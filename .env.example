# ── Database ──────────────────────────────────────────────────────────────────
# Overridden by docker-compose environment block when running in Docker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticket_support

# ── AWS Cognito JWT validation ─────────────────────────────────────────────
COGNITO_USER_POOL_ID=us-east-1_abc123
COGNITO_REGION=us-east-1
COGNITO_APP_CLIENT_ID=

# ── LangFuse observability (optional) ────────────────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://localhost:3010
LANGSMITH_API_KEY=lsv2_pt_

OPENAI_API_KEY=sk-proj--

# ── Backend (NestJS) ─────────────────────────────────────────────────────────
NESTJS_BASE_URL=http://localhost:3000
# Shared machine secret. Sent by the backend as X-System-Key on non-chat calls,
# and by the agent as X-Agent-Key on its outbound calls.
WEBHOOK_API_KEY=dev-webhook-secret

# ── FinOps spend-file repair (machine-to-machine) ────────────────────────────
# S3 bucket the agent reads originals from / writes corrected files to.
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
# Optional: when set, callers must also send x-hmac-signature (sha256 over the body).
AGENT_MACHINE_HMAC_SECRET=
# Model used for column-mapping inference when repairing spend files.
SPEND_FIX_MODEL=gpt-5.6-luna
